{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"$(git rev-parse --show-toplevel)/scripts/pdh-session-hook.sh\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
